# Royal Care Hospital - F&B inventory and billing
#
# The house whitespace rules, in the one file every editor reads without being asked. There is
# no Prettier here and oxlint does not format, so until now the only thing holding two-space
# indentation and LF line endings together was that everyone happened to be on the same editor.
# A single CRLF in a shell script under deploy/ is a broken deploy, not a diff nit.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false

# Generated by pnpm; never hand-edited, and its own indentation is not ours to set.
[pnpm-lock.yaml]
indent_size = unset
