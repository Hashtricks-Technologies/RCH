# The browser mints its own X-Request-Id and reads the same id back off the response
# (UI/src/api/client.ts), so what nginx forwards has to be the id it was handed - `$request_id`
# on its own overwrites it, and the id in the access log then matches nothing anybody can quote.
# `map` runs per request in http context: keep the client's id, and mint one only when the
# request arrived without one (the empty-string branch).
map $http_x_request_id $req_id {
  default $http_x_request_id;
  ""      $request_id;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Defer upstream DNS resolution to request time using the resolvers the
  # container itself was handed, via /etc/resolv.conf, by the base image's
  # own local-resolvers entrypoint script (enabled with
  # NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile). This works
  # unmodified under Docker's embedded DNS and under Kubernetes/CoreDNS
  # alike. Without it, proxy_pass with a literal host resolves eagerly at
  # nginx startup and the whole process fails to start if the API service
  # isn't resolvable yet.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  # The security headers (CSP, X-Frame-Options, nosniff, Referrer-Policy) live in
  # deploy/nginx/snippets, copied to /etc/nginx/rch/ by UI/Dockerfile. nginx inherits add_header
  # from this level only into a location that sets none of its own, so every location below that
  # adds a header includes the snippet again - without that, index.html and every asset went out
  # with no CSP at all.
  include /etc/nginx/rch/security-headers.conf;

  # Two health endpoints, because the ALB's healthcheck-path is an INGRESS-level annotation: the
  # controller applies it to every target group the ingress creates, the ui's as well as the
  # api's. With only /healthz here, a check on /readyz fell through to the SPA catch-all at the
  # bottom of this file and passed on index.html - a 200 that says nothing about nginx. nginx has
  # no draining state of its own to report, so both answer the same thing.
  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location = /readyz { return 200 'ok'; add_header Content-Type text/plain; }

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $req_id;
    proxy_read_timeout 60s;
  }
  # The audit service's two read routes (GET /api/v1/admin/audit and /api/v1/admin/audit/:id).
  # nginx picks the longest matching prefix, so this wins over /api/ above wherever it is written.
  # The same forwarding headers: the audit service trusts one hop too, and logs the browser's id.
  location /api/v1/admin/audit {
    set $audit_upstream ${AUDIT_UPSTREAM};
    proxy_pass $audit_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $req_id;
    proxy_read_timeout 60s;
  }
  # Server-sent events (Phase 3): no buffering, long read timeout.
  location /api/v1/events {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $host;
    # The same forwarding headers /api/ sends: the API trusts one hop (TRUST_PROXY), so without
    # them a stream's rate-limit key and its access log read as nginx's own address, and the
    # request id the browser was handed never reaches the log line that opened the stream.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $req_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    chunked_transfer_encoding off;
  }

  location /assets/ {
    include /etc/nginx/rch/security-headers.conf;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
  # The public QR ordering page (UI/src/pages/public): the same SPA, and the same no-cache on
  # index.html as `/`, under a CSP that also admits Razorpay Standard Checkout
  # (snippets/order-security-headers.conf). Its script and styles are the hashed files under
  # /assets/, served by the block above with the app's own policy - a CSP is read off the
  # document, not off the scripts it loads, so that is correct.
  # `/index.html` is a file check here, not the fallback: as the last argument try_files makes it
  # an internal redirect, which `location /` would answer - with the staff CSP, and checkout.js
  # blocked. As a middle argument the file is served from this block, with this block's headers.
  location /order/ {
    include /etc/nginx/rch/order-security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html =404;
  }
  location / {
    include /etc/nginx/rch/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
