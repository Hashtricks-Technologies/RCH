# The browser mints its own X-Request-Id and reads the same id back off the response
# (UI/src/api/client.ts), so what nginx forwards has to be the id it was handed - `$request_id`
# on its own overwrites it, and the id in the access log then matches nothing anybody can quote.
# `map` runs per request in http context: keep the client's id, and mint one only when the
# request arrived without one (the empty-string branch).
map $http_x_request_id $req_id {
  default $http_x_request_id;
  ""      $request_id;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Defer upstream DNS resolution to request time using the resolvers the
  # container itself was handed, via /etc/resolv.conf, by the base image's
  # own local-resolvers entrypoint script (enabled with
  # NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile). This works
  # unmodified under Docker's embedded DNS and under Kubernetes/CoreDNS
  # alike. Without it, proxy_pass with a literal host resolves eagerly at
  # nginx startup and the whole process fails to start if the API service
  # isn't resolvable yet.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'" always;

  # Two health endpoints, because the ALB's healthcheck-path is an INGRESS-level annotation: the
  # controller applies it to every target group the ingress creates, the ui's as well as the
  # api's. With only /healthz here, a check on /readyz fell through to the SPA catch-all at the
  # bottom of this file and passed on index.html - a 200 that says nothing about nginx. nginx has
  # no draining state of its own to report, so both answer the same thing.
  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location = /readyz { return 200 'ok'; add_header Content-Type text/plain; }

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $req_id;
    proxy_read_timeout 60s;
  }
  # Server-sent events (Phase 3): no buffering, long read timeout.
  location /api/v1/events {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $host;
    # The same forwarding headers /api/ sends: the API trusts one hop (TRUST_PROXY), so without
    # them a stream's rate-limit key and its access log read as nginx's own address, and the
    # request id the browser was handed never reaches the log line that opened the stream.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $req_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    chunked_transfer_encoding off;
  }

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
}
