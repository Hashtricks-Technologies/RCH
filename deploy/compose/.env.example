# Copy to deploy/compose/.env on the box (never commit the real file - it is gitignored) and
# fill every value below. `deploy.sh` reads this file; `compose.yml` fails closed (`:?message`)
# on anything left blank rather than starting with an empty secret.

# The hostname Caddy requests a certificate for and the API's CORS_ORIGIN is built from.
DOMAIN=rch.hashtrickstechnologies.com

# The container Postgres's own password - anything long and random; it is never reachable
# outside this box's Docker network. It is the superuser `rch`'s, used only by `migrate`,
# `audit-migrate` and the operator CLIs run through `migrate`.
POSTGRES_PASSWORD=

# The two runtime roles' passwords: `api` connects as rch_app, `audit` as rch_audit. `migrate`
# and `audit-migrate` create each role with this password (and reset it on every deploy, so a
# change here takes effect on the next one). They sit inside a postgres:// URL, so letters and
# digits only - `openssl rand -hex 24` makes a good one. Both are required.
APP_DB_PASSWORD=
AUDIT_DB_PASSWORD=

# Ed25519 key pair, PEM, base64-encoded - generate with:
#   pnpm --filter @rch/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional: the previous public key, kept readable for 24h after a rotation. Leave blank the
# first time.
JWT_PREVIOUS_PUBLIC_KEY=

# At least 12 characters, no default (apps/api/src/config.ts) - the password the seeded
# accounts start on. Choose one and keep it; `deploy.sh` only seeds an empty database.
SEED_PASSWORD=

# The private S3 bucket item photos are stored in (RUNBOOK §16.8). The box's instance role has
# Get/Put/Delete on items/* in it and nothing else.
IMAGE_BUCKET=

# Outlet QR ordering with Razorpay (RUNBOOK §19). Optional, unlike everything above: left blank,
# the stack starts as before and placing a QR order answers 503 "Online ordering is not set up yet
# - order at the counter." Set all three together - the key id and secret from Razorpay's
# Dashboard → Account & Settings → API Keys, and the secret you typed into the webhook you created
# there. Test keys (rzp_test_...) until the hospital goes live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional tunables; blank keeps the default. The most one QR order may come to, in rupees (5000);
# minutes an unpaid order waits for payment (30); milliseconds between QR worker passes - expiry
# and refunds (30000; 0 switches the worker off, which leaves refunds unsent: don't, here); unpaid
# orders one address may place in half an hour (20 - a ward's guest Wi-Fi is one address).
QR_ORDER_MAX_RUPEES=
QR_ORDER_TTL_MIN=
QR_WORKER_INTERVAL_MS=
QR_PENDING_PER_IP=

# Read by backup.sh only (deploy.sh and compose.yml never touch this) - the S3 bucket the
# nightly logical dump is uploaded to. The box's own instance profile is scoped to exactly
# this bucket.
BACKUP_BUCKET=
