{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/fixtures/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/server.ts",
        "src/cli/*.ts",
        "drizzle.config.ts",
        "tsup.config.ts",
        "scripts/strip-public-schema.mjs"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
