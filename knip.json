{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/cli/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreFiles": [
    "apps/api/src/lib/rules.ts"
  ],
  "ignoreExportsUsedInFile": true
}
