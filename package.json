{
  "name": "rch",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && knip && bash scripts/check-boundaries.sh",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "test": "turbo run test",
    "helm:test": "deploy/chart/rch/tests/render.test.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "knip": "^6.34.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "~6.0.2"
  }
}
