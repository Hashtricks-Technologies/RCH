{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint":      {},
    "test":      { "dependsOn": ["^typecheck"], "env": ["DATABASE_URL", "TEST_DATABASE_URL"] },
    "dev":       { "cache": false, "persistent": true }
  }
}
