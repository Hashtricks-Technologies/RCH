# apps/api - copy to .env at the repo root for local development
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local Postgres runs on host port 5439 (not 5432) to avoid clashing with a native Postgres install.
DATABASE_URL=postgres://rch:rch@localhost:5439/rch
# Who db:migrate and the operator CLIs (seed, users, payers, purge, rebuild-balances) connect as.
# Unset, they use DATABASE_URL. Set to a different user, db:migrate also creates DATABASE_URL's user
# as a login role, sets its password from that URL, and grants it the API's least privileges
# (insert-only on audit_outbox). Locally one user does everything, so it stays commented out.
# MIGRATE_DATABASE_URL=postgres://rch:rch@localhost:5439/rch
TEST_DATABASE_URL=postgres://rch:rch@localhost:5439/rch_test
# Left unset it follows NODE_ENV: on in production (RDS, verified against the bundled CA), off
# anywhere else - which is why it is commented out rather than pinned. Uncomment to overrule that
# in either direction, e.g. to point a local process at a real instance.
# DATABASE_SSL=false
# Connections this process's pool may hold. A request takes exactly one (every read runs in one
# read-only transaction), so raise it only with a bigger instance behind it - deploy/RUNBOOK.md §12.
DB_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173
# Ed25519 key pair, PEM, base64-encoded so newlines survive env files. Generate: pnpm --filter @rch/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEY=           # optional, accepted for 24h after a rotation
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                # true everywhere but local http
# Required, at least 12 characters, no default: whoever seeds a host chooses the password the six
# seeded accounts start on. A published default would be the same password on every host that ever
# ran the seed. Locally, anything long enough will do; in staging/prod it comes from the Secret.
SEED_PASSWORD=
SEED_FORCE_PASSWORD_CHANGE=false   # true in staging/prod seeds
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_EMP_PER_MINUTE=5   # per employee id, independent of the per-IP limit above
# 1 = trust exactly one proxy hop (the ALB / the Vite dev proxy); set to the ingress CIDR or hop count if the topology differs
TRUST_PROXY=1
# Where item photo bytes live. Left unset it is "disk" (apps/api/.data/images, gitignored) - fine
# for local development and the test suite. A production process refuses "disk": set IMAGE_STORE=s3
# with IMAGE_BUCKET and AWS_REGION instead (deploy/RUNBOOK.md §16.8).
# IMAGE_STORE=disk
# IMAGE_DIR=.data/images
# IMAGE_BUCKET=
# AWS_REGION=

# Outlet QR ordering with Razorpay online payment (deploy/RUNBOOK.md §19). All optional. Until all
# three keys are set, the public order page still shows the menu, but placing an order answers 503
# "Online ordering is not set up yet - order at the counter." Use Razorpay TEST keys locally
# (rzp_test_...); the webhook secret is the one typed into the Razorpay dashboard's webhook.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Tunables, shown at their defaults: the most one QR order may come to, in rupees; how long an
# unpaid order waits for its payment before it expires; how often the QR worker expires unpaid
# orders and sends queued refunds (0 switches the worker off - tests do that); and how many unpaid
# orders one address may place in half an hour (generous: a ward's Wi-Fi is one address).
# QR_ORDER_MAX_RUPEES=5000
# QR_ORDER_TTL_MIN=30
# QR_WORKER_INTERVAL_MS=30000
# QR_PENDING_PER_IP=20

# apps/audit - `pnpm dev` starts it beside the API on port 3100 (its dev script sets PORT itself,
# because PORT above is the API's; Node's --env-file never overrides a variable already set).
# It reads JWT_PUBLIC_KEY, JWT_PREVIOUS_PUBLIC_KEY, TRUST_PROXY, LOG_LEVEL, DATABASE_SSL and
# DB_POOL_MAX above too. Locally it connects as the same superuser the API does: when a runtime
# URL's user is the migrate user, neither migrate CLI creates or grants a role, so a local database
# needs no rch_app or rch_audit. `pnpm --filter @rch/audit db:migrate` creates the audit schema.
# Its migrate CLI reads MIGRATE_DATABASE_URL as the API's does, and falls back to this URL.
AUDIT_DATABASE_URL=postgres://rch:rch@localhost:5439/rch
