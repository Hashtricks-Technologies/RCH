# apps/api — copy to .env at the repo root for local development
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local Postgres runs on host port 5439 (not 5432) to avoid clashing with a native Postgres install.
DATABASE_URL=postgres://rch:rch@localhost:5439/rch
TEST_DATABASE_URL=postgres://rch:rch@localhost:5439/rch_test
# Left unset it follows NODE_ENV: on in production (RDS, verified against the bundled CA), off
# anywhere else — which is why it is commented out rather than pinned. Uncomment to overrule that
# in either direction, e.g. to point a local process at a real instance.
# DATABASE_SSL=false
# Connections this process's pool may hold. A request takes exactly one (every read runs in one
# read-only transaction), so raise it only with a bigger instance behind it — deploy/RUNBOOK.md §12.
DB_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173
# Ed25519 key pair, PEM, base64-encoded so newlines survive env files. Generate: pnpm --filter @rch/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEY=           # optional, accepted for 24h after a rotation
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                # true everywhere but local http
# Required, at least 12 characters, no default: whoever seeds a host chooses the password the six
# seeded accounts start on. A published default would be the same password on every host that ever
# ran the seed. Locally, anything long enough will do; in staging/prod it comes from the Secret.
SEED_PASSWORD=
SEED_FORCE_PASSWORD_CHANGE=false   # true in staging/prod seeds
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_EMP_PER_MINUTE=5   # per employee id, independent of the per-IP limit above
# 1 = trust exactly one proxy hop (the ALB / the Vite dev proxy); set to the ingress CIDR or hop count if the topology differs
TRUST_PROXY=1
